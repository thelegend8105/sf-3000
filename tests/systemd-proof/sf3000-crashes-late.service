# Proof B - a service that starts fine and dies 10s later.
# `systemctl restart` exits 0 for it (Type=simple returns once forked), so
# only the 30s settle wait can catch it. Expected after --fix: verify_failed.
# Without the wait the engine would have reported healed.
[Unit]
Description=SF3000 proof B - runs for 10s, then crashes

[Service]
Type=simple
ExecStart=/bin/sh -c 'sleep 10; exit 1'
